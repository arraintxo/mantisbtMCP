# MantisBT API Configuration
API_URL=https://mantis.example.com
API_TOKEN=abcd1234567890efgh

# Transport Mode Configuration
# Options: 'stdio' (default) or 'httpStream'
TRANSPORT_MODE=stdio

# HTTP Stream Settings (only used when TRANSPORT_MODE=httpStream)
HTTP_PORT=8088
HTTP_HOST=0.0.0.0

# Example:
# API_URL=https://mantis.example.com
# API_TOKEN=abcd1234567890efgh
